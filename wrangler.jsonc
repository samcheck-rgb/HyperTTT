{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hyper-tic-tac-toe",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_LOBBY", "class_name": "GameLobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameLobby"] }
  ]
}
